# 生产形态的站点配置：nginx 自己监听 443、用学校发的证书终止 TLS，本容器直接
# 对校园网提供服务，前面没有 caddy、没有隧道。由 docker-compose.prod.yml 和证书
# 目录一起挂到 /etc/nginx/templates/default.conf.template，顶掉镜像默认的
# nginx.conf.template（内测与 CI 用的 http 那份）。
#
# 不做真实 IP 还原：nginx 就是最外面一层，$remote_addr 直接是浏览器地址。
# 这里若信任 X-Forwarded-For，校园网里与 compose 网段重叠的来源就能自报 IP。
#
# 文件名带 .template：nginx 官方镜像的入口脚本会在启动时把 ${...} 替换成同名
# 环境变量，替换结果写到 /etc/nginx/conf.d/default.conf。
#
# 站点主体（响应头、上传上限、gzip、/api 反代、SPA 回退）在
# /etc/nginx/snippets/yvruc-shared.conf，三份形态共用一份，见 nginx-shared.conf。

# 二维码要按「浏览器实际用的地址」拼出对外网址。本形态下浏览器直连，$scheme
# 就是 https；客户端自带的 X-Forwarded-Proto 一律不认。变量名与另两份配置一致，
# 共用片段里直接用。
map $http_x_forwarded_proto $fwd_proto {
    default $scheme;
}

# 访问日志只记路径，不记查询串。下载票据一分钟即失效、用一次即作废，
# 但没有任何理由让它进日志——地址栏里出现过的东西，日志里能不留就不留。
log_format yvruc '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# 缓存策略按路径算，算完统一在 server 里发（原因见 nginx-shared.conf）。
map $uri $cache_control {
    default          "no-cache";
    "~^/api/"        "";
    "~^/assets/"     "public, max-age=31536000, immutable";
    # 监控页面的响应不在这里加缓存头：它自己按文件算（静态文件带内容哈希的
    # 永久缓存、其余一小时），这里再加一个只会变成两个互相打架的头
    "~^/monitor/"    "";
    "/version.json"  "no-store";
}

server {
    listen 443 ssl;
    http2 on;
    # 不限制主机名：证书里写的是哪个域名就是哪个，配置里再写一遍只会多一处要同步。
    server_name _;
    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log yvruc;

    # 证书目录由 compose 挂进来（YVRUC_CERTS_DIR → /etc/nginx/certs），两个文件：
    #   fullchain.pem  站点证书 + 中间证书（学校发的 server.cer 本身就是完整链）
    #   privkey.pem    私钥
    # 换证书＝替换这两个文件 + `docker exec yvruc-web nginx -s reload`，配置不用改。
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 只留 1.2 / 1.3：1.0 与 1.1 早该退场，留着只会被安全扫描记一笔。
    ssl_protocols TLSv1.2 TLSv1.3;

    # 只在这份配置里发：另两份是明文 http，浏览器对 http 响应上的 HSTS 一律忽略，
    # 发了也没有意义。设了以后浏览器半年内自己把 http:// 改成 https，校园网里
    # 劫持第一次请求、把页面换成钓鱼页这条路就走不通了。
    #
    # 不加 includeSubDomains：证书是 *.ruc.edu.cn，这个域下面还有别家的系统，
    # 我们没资格替它们做「只准 https」的决定。半年也不是两年——真要临时退回
    # http 调试，得等浏览器里那条记录过期。
    #
    # 注意扫描器是按 IP（10.173.23.54）扫的，浏览器对 IP 不认 HSTS，所以这条
    # 加了之后按 IP 重扫仍会报；按域名扫才会消掉。
    add_header Strict-Transport-Security "max-age=15552000" always;
    # 只留 ECDHE 套件：nginx 的默认套件里带着 RSA 密钥交换的那几组，没有前向保密，
    # 扫描器会单记一条「远程主机支持 RSA 密钥交换」。TLS 1.3 的套件不在这里控制，
    # 本身都带前向保密。
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    # 会话复用：管理员连着点页面时省一次完整握手，代价只是几 MB 共享内存
    ssl_session_cache shared:SSL:4m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    # 错误监控页面：GlitchTip 挂在 /monitor/ 下（见 ops/monitoring.md）。
    # 服务器上不开新端口，用这个已有的 443 域名进。
    #
    # 路径原样转过去、nginx 不剥前缀：GlitchTip 自己设了 BASE_PATH，由它剥
    # （Django 的脚本前缀），它的静态资源也按带前缀的路径登记。先剥掉的话，
    # 它认不出这些请求，页面样式和脚本全丢。
    #
    # 用变量而不是直接写 http://glitchtip:8000：直接写时 nginx 在启动那一刻就要
    # 解析这个名字，解析不到就拒绝启动。监控服务是单独一份编排，停掉它、或者
    # 先起平台后起监控时，整个平台会跟着起不来。写成变量后只在请求进来时解析，
    # 监控不在只是这一个路径返回 502。
    location = /monitor { return 301 /monitor/; }

    # 静态资源要单独剥掉 /monitor：GlitchTip 的 WhiteNoise 只按 /static/... 查
    # （实测同一个文件：/static/... 是 200，/monitor/static/... 是 404）。不剥的话
    # 页面能打开、样式与脚本全 404，浏览器拿到 HTML 却跑不起来，表现是白屏。
    # 这条必须写在下面那条之前——nginx 的正则 location 按书写顺序匹配。
    location ~ ^/monitor/static/(.*)$ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $monitoring http://glitchtip:8000;
        proxy_pass $monitoring/static/$1$is_args$args;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/monitor(/|$) {
        # Docker 自带的内网 DNS。换了别的容器网络时要跟着改。
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $monitoring http://glitchtip:8000;
        proxy_pass $monitoring;

        proxy_set_header Host $http_host;
        # 和 /api/ 一样用 $remote_addr 覆盖，不追加客户端自带的 X-Forwarded-For
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # 这一跳是 https 终点，监控服务按它认 https（登录表单的 CSRF 校验要用）
        proxy_set_header X-Forwarded-Proto https;
    }

    include /etc/nginx/snippets/yvruc-shared.conf;
}
