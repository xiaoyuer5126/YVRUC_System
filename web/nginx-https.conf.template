# 生产形态的站点配置：nginx 自己监听 443、用学校发的证书终止 TLS，本容器直接
# 对校园网提供服务，前面没有 caddy、没有隧道。由 docker-compose.prod.yml 和证书
# 目录一起挂到 /etc/nginx/templates/default.conf.template，顶掉镜像默认的
# nginx.conf.template（内测与 CI 用的 http 那份）。
#
# 不做真实 IP 还原：nginx 就是最外面一层，$remote_addr 直接是浏览器地址。
# 这里若信任 X-Forwarded-For，校园网里与 compose 网段重叠的来源就能自报 IP。
#
# 文件名带 .template：nginx 官方镜像的入口脚本会在启动时把 ${...} 替换成同名
# 环境变量，替换结果写到 /etc/nginx/conf.d/default.conf。
#
# 站点主体（响应头、上传上限、gzip、/api 反代、SPA 回退）在
# /etc/nginx/snippets/yvruc-shared.conf，三份形态共用一份，见 nginx-shared.conf。

# 二维码要按「浏览器实际用的地址」拼出对外网址。本形态下浏览器直连，$scheme
# 就是 https；客户端自带的 X-Forwarded-Proto 一律不认。变量名与另两份配置一致，
# 共用片段里直接用。
map $http_x_forwarded_proto $fwd_proto {
    default $scheme;
}

# 访问日志只记路径，不记查询串。下载票据一分钟即失效、用一次即作废，
# 但没有任何理由让它进日志——地址栏里出现过的东西，日志里能不留就不留。
log_format yvruc '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# 缓存策略按路径算，算完统一在 server 里发（原因见 nginx-shared.conf）。
map $uri $cache_control {
    default          "no-cache";
    "~^/api/"        "";
    "~^/assets/"     "public, max-age=31536000, immutable";
    "/version.json"  "no-store";
}

server {
    listen 443 ssl;
    http2 on;
    # 不限制主机名：证书里写的是哪个域名就是哪个，配置里再写一遍只会多一处要同步。
    server_name _;
    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log yvruc;

    # 证书目录由 compose 挂进来（YVRUC_CERTS_DIR → /etc/nginx/certs），两个文件：
    #   fullchain.pem  站点证书 + 中间证书（学校发的 server.cer 本身就是完整链）
    #   privkey.pem    私钥
    # 换证书＝替换这两个文件 + `docker exec yvruc-web nginx -s reload`，配置不用改。
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 只留 1.2 / 1.3：1.0 与 1.1 早该退场，留着只会被安全扫描记一笔。
    # 套件不写死，用镜像自带的默认值——nginx 的默认套件随版本更新，写死一份
    # 反而会在某次升级后变成比默认更差的那一份。
    ssl_protocols TLSv1.2 TLSv1.3;
    # 会话复用：管理员连着点页面时省一次完整握手，代价只是几 MB 共享内存
    ssl_session_cache shared:SSL:4m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    include /etc/nginx/snippets/yvruc-shared.conf;
}
