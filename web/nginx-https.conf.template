# 生产形态的站点配置：nginx 自己监听 443、用学校发的证书终止 TLS。80 只做一件事：把 http 301 跳到
# https 的同一地址（见文件末尾）。由 docker-compose.prod.yml 和证书
# 目录一起挂到 /etc/nginx/templates/default.conf.template，顶掉镜像默认的
# nginx.conf.template（内测与 CI 用的 http 那份）。
#
# 文件名带 .template：nginx 官方镜像的入口脚本会在启动时把 ${...} 替换成同名
# 环境变量，替换结果写到 /etc/nginx/conf.d/default.conf。
#
# 站点主体（响应头、上传上限、gzip、/api 反代、SPA 回退）在
# /etc/nginx/snippets/yvruc-shared.conf，三份形态共用一份，见 nginx-shared.conf。

# —— 真实客户端地址 ——
# 2026-11-25 开通公网后，域名 volunteer.ruc.edu.cn 解析到学校网关
# （rucfd2026.ruc.edu.cn），按域名来的访问——校外的、校内走 IPv6 的——都由网关
# 转过来，$remote_addr 是网关地址（已见 10.21.35.55/.56/.60），用户的真实地址
# 在网关写的 X-Forwarded-For 里，有时还经过网关内部的第二跳。直连服务器内网
# 地址的请求不经过网关，不带这个头，$remote_addr 本来就是浏览器地址。
#
# 不还原的话，统一身份认证登录入口按 IP 的限流会把所有人算成一个人，操作日志
# 和访问日志里的 IP 全是网关的。
#
# 只信网关网段（YVRUC_GATEWAY_CIDR，默认 10.21.35.0/24，由 docker-compose.prod.yml
# 传进来）：从这个网段来的请求，从 X-Forwarded-For 右边往左跳过所有网关地址，取
# 第一个不是网关的；别处来的请求带了这个头也不认，$remote_addr 保持原样。
# 这个头谁都能自己加，所以信任范围不能放宽到网关以外，填 0.0.0.0/0 等于谁都能
# 伪造 IP、绕过登录限流。网段是负责人观察日志定的，学校信息技术中心还没给准确
# 范围；给了之后改 .env 里这一项，不用改这里。
#
# 后端不用跟着改：/api 反代用 $remote_addr 覆盖 X-Real-IP 和 X-Forwarded-For
# （nginx-shared.conf 的 /api 段、下面的 /monitor 段），还原后传下去的就是真实地址。
set_real_ip_from ${YVRUC_GATEWAY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive on;

# 二维码要按「浏览器实际用的地址」拼出对外网址。本形态下浏览器直连，$scheme
# 就是 https；客户端自带的 X-Forwarded-Proto 一律不认。变量名与另两份配置一致，
# 共用片段里直接用。
map $http_x_forwarded_proto $fwd_proto {
    default $scheme;
}

# 访问日志只记路径，不记查询串。下载票据一分钟即失效、用一次即作废，
# 但没有任何理由让它进日志——地址栏里出现过的东西，日志里能不留就不留。
log_format yvruc '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# 缓存策略按路径算，算完统一在 server 里发（原因见 nginx-shared.conf）。
map $uri $cache_control {
    default          "no-cache";
    "~^/api/"        "";
    "~^/assets/"     "public, max-age=31536000, immutable";
    # 监控页面的响应不在这里加缓存头：它自己按文件算（静态文件带内容哈希的
    # 永久缓存、其余一小时），这里再加一个只会变成两个互相打架的头
    "~^/monitor/"    "";
    "/version.json"  "no-store";
}

# http 跳 https 时要不要带端口：宿主机 HTTPS 端口是 443 就不带，否则带上
# （如 https://host:8443/...）。HTTPS_HOST_PORT 由 docker-compose.prod.yml 传进
# 容器（留空按 443），入口脚本启动时把下面的 ${...} 换成实际端口。
map "${HTTPS_HOST_PORT}" $https_port_suffix {
    "443"   "";
    default ":${HTTPS_HOST_PORT}";
}

server {
    listen 443 ssl;
    http2 on;
    # 不限制主机名：证书里写的是哪个域名就是哪个，配置里再写一遍只会多一处要同步。
    server_name _;
    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log yvruc;

    # 证书目录由 compose 挂进来（YVRUC_CERTS_DIR → /etc/nginx/certs），两个文件：
    #   fullchain.pem  站点证书 + 中间证书（学校发的 server.cer 本身就是完整链）
    #   privkey.pem    私钥
    # 换证书＝替换这两个文件 + `docker exec yvruc-web nginx -s reload`，配置不用改。
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 只留 1.2 / 1.3：1.0 与 1.1 早该退场，留着只会被安全扫描记一笔。
    ssl_protocols TLSv1.2 TLSv1.3;

    # 只在这份配置里发：另两份是明文 http，浏览器对 http 响应上的 HSTS 一律忽略，
    # 发了也没有意义。设了以后浏览器半年内自己把 http:// 改成 https，校园网里
    # 劫持第一次请求、把页面换成钓鱼页这条路就走不通了。
    #
    # 不加 includeSubDomains：证书是 *.ruc.edu.cn，这个域下面还有别家的系统，
    # 我们没资格替它们做「只准 https」的决定。半年也不是两年——真要临时退回
    # http 调试，得等浏览器里那条记录过期。
    #
    # 注意扫描器是按 IP（10.173.23.54）扫的，浏览器对 IP 不认 HSTS，所以这条
    # 加了之后按 IP 重扫仍会报；按域名扫才会消掉。
    add_header Strict-Transport-Security "max-age=15552000" always;
    # 只留 ECDHE 套件：nginx 的默认套件里带着 RSA 密钥交换的那几组，没有前向保密，
    # 扫描器会单记一条「远程主机支持 RSA 密钥交换」。TLS 1.3 的套件不在这里控制，
    # 本身都带前向保密。
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    # 会话复用：管理员连着点页面时省一次完整握手，代价只是几 MB 共享内存
    ssl_session_cache shared:SSL:4m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    # 错误监控页面：GlitchTip 挂在 /monitor/ 下（见 ops/monitoring.md）。
    # 服务器上不开新端口，用这个已有的 443 域名进。
    #
    # 路径原样转过去、nginx 不剥前缀：GlitchTip 自己设了 BASE_PATH，由它剥
    # （Django 的脚本前缀），它的静态资源也按带前缀的路径登记。先剥掉的话，
    # 它认不出这些请求，页面样式和脚本全丢。
    #
    # 用变量而不是直接写 http://glitchtip:8000：直接写时 nginx 在启动那一刻就要
    # 解析这个名字，解析不到就拒绝启动。监控服务是单独一份编排，停掉它、或者
    # 先起平台后起监控时，整个平台会跟着起不来。写成变量后只在请求进来时解析，
    # 监控不在只是这一个路径返回 502。
    location = /monitor { return 301 /monitor/; }

    # 静态资源要单独剥掉 /monitor：GlitchTip 的 WhiteNoise 只按 /static/... 查
    # （实测同一个文件：/static/... 是 200，/monitor/static/... 是 404）。不剥的话
    # 页面能打开、样式与脚本全 404，浏览器拿到 HTML 却跑不起来，表现是白屏。
    # 这条必须写在下面那条之前——nginx 的正则 location 按书写顺序匹配。
    location ~ ^/monitor/static/(.*)$ {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $monitoring http://glitchtip:8000;
        proxy_pass $monitoring/static/$1$is_args$args;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ~ ^/monitor(/|$) {
        # Docker 自带的内网 DNS。换了别的容器网络时要跟着改。
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $monitoring http://glitchtip:8000;
        proxy_pass $monitoring;

        proxy_set_header Host $http_host;
        # 和 /api/ 一样用 $remote_addr 覆盖，不追加客户端自带的 X-Forwarded-For
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        # 这一跳是 https 终点，监控服务按它认 https（登录表单的 CSRF 校验要用）
        proxy_set_header X-Forwarded-Proto https;
    }

    include /etc/nginx/snippets/yvruc-shared.conf;
}

# 80 端口：只做 http → https 跳转（学校信息技术中心 2026-11-16 许可放行 80 入向）。
# 不 include 共用片段、不反代任何东西：/api、/monitor 都不在明文 http 上提供，
# 请求还没到后端就被打回 https，令牌和表单不会经明文走一遍。
# 不发 HSTS：浏览器对 http 响应上的 HSTS 一律忽略，443 那边已经发了。
# 用 301：浏览器会记住这次跳转，下次手打 http:// 不再经过这里。
server {
    listen 80;
    server_name _;
    # 共用片段里那条 server_tokens off 不在这个 server 里，单独写一遍
    server_tokens off;
    access_log /var/log/nginx/access.log yvruc;

    # $host 取请求自带的主机名（没带就是 server_name，这里不会发生：浏览器都带）。
    # 按 IP 访问时跳到 https://IP/，浏览器会报证书与地址不符，和直接访问 443 一样。
    return 301 https://$host$https_port_suffix$request_uri;
}
