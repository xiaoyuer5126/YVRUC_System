# 校青协平台 · web 容器站点配置
# 静态资源本地托管，业务接口反代到 backend 容器（同源，无跨域问题）。
#
# 本容器只监听 80，前面有两个入口，两边都以 http 打进来：
#   · caddy（宿主机 443，TLS 由它终止）→ web:80，内网直连这条路
#   · cloudflared（TLS 在 Cloudflare 边缘终止）→ web:80，公网这条路
# 所以这里不配证书、不开 443。
#
# 文件名带 .template：nginx 官方镜像的入口脚本会在启动时把 ${...} 替换成同名
# 环境变量，替换结果写到 /etc/nginx/conf.d/default.conf。所以这个文件里
# **${开头的都是占位符**，nginx 自己的变量（$remote_addr、$scheme 这些）不受影响。

# —— 真实客户端地址 ——
# 本容器前面一定有一跳反代（caddy 或 cloudflared），它看到的对端只是那一跳的
# 容器 IP。反代把它看到的真实客户端写在 X-Forwarded-For 的最右边（caddy 丢掉
# 客户端自带的这个头、只写自己看到的对端），这里用 real_ip 模块把它还原成 $remote_addr：
# 不这样做，操作日志里的 IP 全是容器地址，登录失败限流也会把所有人算成一个人。
#
# real_ip_recursive off = 取**最右边那一跳**。后端启动参数是
# --forwarded-allow-ips '*'（谁都能自报 IP），所以「最右边」才是反代亲自看到的
# 那个对端；取最左边等于让客户端自己填。信任范围限定成 compose 网络
# （YVRUC_TRUSTED_PROXY_CIDR，默认 172.30.0.0/16，见 docker-compose.yml 的
# networks 定义——两者必须一致），公网来的请求伪造这个头也不会被采信。
set_real_ip_from ${YVRUC_TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive off;

# 二维码要按「浏览器实际用的地址」拼出对外网址，所以协议不能被这一跳覆盖：
# caddy / cloudflared 到本容器之间都是明文 http，$scheme 就是 http，直接写下去
# 会让 https 站点生成 http:// 的码。有上游传下来的就用上游的，没有才用 $scheme。
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# 访问日志只记路径，不记查询串。下载票据一分钟即失效、用一次即作废，
# 但没有任何理由让它进日志——地址栏里出现过的东西，日志里能不留就不留。
log_format yvruc '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# 缓存策略按路径算，算完统一在 server 里发。
# 不在各个 location 里写 add_header：nginx 的 add_header 一旦出现在 location
# 里，就会把 server 层那一整组头全部顶掉——安全响应头会连带丢失，而且丢得
# 悄无声息。/api/ 给空串表示不发，由后端自己决定（二维码是 no-store）。
map $uri $cache_control {
    default          "no-cache";
    "~^/api/"        "";
    "~^/assets/"     "public, max-age=31536000, immutable";
    "/version.json"  "no-store";
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log yvruc;

    # —— 响应头 ——
    # 令牌存在浏览器里，所以 XSS 一旦发生就是会话失守。CSP 是第二道墙：
    # 先用 Report-Only 跑一阵，确认没有误伤再去掉 -Report-Only 强制执行。
    # style-src 的 unsafe-inline 是 Element Plus 要的（组件自己写内联样式）；
    # static.cloudflareinsights.com 是 Cloudflare 的访问统计脚本。
    # img-src 只要 'self'：管理端签到地图的瓦片由后端转发（/api/geo/tiles/，
    # 见 backend/routers/geo.py），浏览器不直连天地图。
    add_header Cache-Control $cache_control always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # camera / geolocation 必须是 (self) 而不是 ()：空括号是「所有来源一律禁用」，
    # 而且是**文档级**策略，在浏览器问用户之前就生效——不弹权限窗、直接失败，
    # 表现得像用户点了拒绝，实则与用户、与手机、与微信都无关。
    # 这两项现在正是功能本身：签到要调摄像头扫码，定位签到要取坐标。
    # 麦克风不用，继续关着。
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=(self)" always;
    add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # 请求体上限按最大的那种合法上传定：活动材料单份 50MB、智能起草 5 份各 10MB
    # （config.MAX_MATERIAL_BYTES / AI_FILE_*），再留点表单余量。每个接口自己
    # 还会按各自的上限拦；这里小于它们的话，合法上传会被 nginx 先回一个 413
    client_max_body_size 64m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # —— 业务 API（含媒体文件、二维码 SVG、Excel 导出流）——
    location /api/ {
        proxy_pass http://backend:8000;
        # $http_host 而不是 $host：后者不含端口，8080 这种非标端口会被丢掉，
        # 二维码兜底拼出来就是个少了端口、打不开的网址。
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        # nginx 就是最外面一层，客户端地址以它看到的为准：用 $remote_addr 覆盖，
        # 不往客户端自带的 X-Forwarded-For 后面追加——后端信任这个头
        # （--forwarded-allow-ips），追加的话谁都能自报 IP，操作日志里的 IP
        # 和登录失败限流就都不作数了
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $fwd_proto;
        proxy_read_timeout 120s;   # 自动排班求解留足时间
        proxy_buffering off;       # StreamingResponse 直接透传
    }

    # 带 content hash 的构建产物：永久缓存（Cache-Control 见上面的 map）
    location /assets/ {
        try_files $uri =404;
    }

    # SPA 回退：前端路由是真实路径（/my、/manage/xxx），不是文件的一律回 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
