# https 形态：nginx 自己监听 443 终止 TLS。内测与生产共用这一份，区别只在证书
# 从哪来、前面有没有反代——两者都在下面的注释里写明，不需要两份配置。
#
#   · 内测（docker-compose.intranet.yml）：用 Caddyfile 挂到 /etc/nginx/certs，
#     证书由 caddy 在宿主机 443 上终止，本容器只在内网被 caddy 访问。
#   · 生产（docker-compose.prod.yml）：挂学校发的证书目录，本容器直接对
#     校园网提供 443，前面没有 caddy、没有隧道。
#
# 文件名带 .template：nginx 官方镜像的入口脚本会在启动时把 ${...} 替换成同名
# 环境变量，替换结果写到 /etc/nginx/conf.d/default.conf。所以这个文件里
# **${开头的都是占位符**，nginx 自己的变量（$remote_addr、$scheme 这些）不受影响。
#
# 站点主体（响应头、上传上限、gzip、/api 反代、SPA 回退）在
# /etc/nginx/snippets/yvruc-shared.conf，两份形态共用一份，见那个文件。

# —— 真实客户端地址 ——
# 生产形态下没有这一跳：nginx 就是最外面一层，$remote_addr 直接是浏览器地址，
# 下面两行不生效也不影响。内测形态前面有 caddy / cloudflared，必须还原，
# 否则操作日志里的 IP 全是容器地址，登录失败限流会把所有人算成一个人。
#
# real_ip_recursive off = 取**最右边那一跳**。后端启动参数是
# --forwarded-allow-ips '*'（谁都能自报 IP），所以「最右边」才是反代亲自看到的
# 那个对端；取最左边等于让客户端自己填。信任范围限定成 compose 网络
# 与 docker-compose.yml 的 networks 定义必须一致，公网来的请求伪造这个头也不会被采信。
set_real_ip_from ${YVRUC_TRUSTED_PROXY_CIDR};
real_ip_header X-Forwarded-For;
real_ip_recursive off;

# 二维码要按「浏览器实际用的地址」拼出对外网址，所以协议不能被这一跳覆盖：
# 内测时 caddy / cloudflared 到本容器之间是明文 http，$scheme 就是 http，直接
# 写下去会让 https 站点生成 http:// 的码；有上游传下来的就用上游的。生产形态下
# 没有这个头，$scheme 正好是 https。
map $http_x_forwarded_proto $fwd_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

# 访问日志只记路径，不记查询串。下载票据一分钟即失效、用一次即作废，
# 但没有任何理由让它进日志——地址栏里出现过的东西，日志里能不留就不留。
log_format yvruc '$remote_addr - [$time_local] "$request_method $uri $server_protocol" '
                 '$status $body_bytes_sent "$http_referer" "$http_user_agent"';

# 缓存策略按路径算，算完统一在 server 里发（原因见 nginx-common.conf）。
map $uri $cache_control {
    default          "no-cache";
    "~^/api/"        "";
    "~^/assets/"     "public, max-age=31536000, immutable";
    "/version.json"  "no-store";
}

server {
    listen 443 ssl;
    http2 on;
    # 不限制主机名：证书里写的是哪个域名就是哪个，配置里再写一遍只会多一处要同步。
    server_name _;
    root /usr/share/nginx/html;

    access_log /var/log/nginx/access.log yvruc;

    # 证书目录由 compose 挂进来（YVRUC_CERTS_DIR → /etc/nginx/certs），两个文件：
    #   fullchain.pem  站点证书 + 中间证书（学校发的 server.cer 本身就是完整链）
    #   privkey.pem    私钥
    # 换证书＝替换这两个文件 + `docker exec yvruc-web nginx -s reload`，配置不用改。
    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    # 只留 1.2 / 1.3：1.0 与 1.1 早该退场，留着只会被安全扫描记一笔。
    # 套件不写死，用镜像自带的默认值——nginx 的默认套件随版本更新，写死一份
    # 反而会在某次升级后变成比默认更差的那一份。
    ssl_protocols TLSv1.2 TLSv1.3;
    # 会话复用：管理员连着点页面时省一次完整握手，代价只是几 MB 共享内存
    ssl_session_cache shared:SSL:4m;
    ssl_session_timeout 1h;
    ssl_session_tickets off;

    include /etc/nginx/snippets/yvruc-shared.conf;
}
