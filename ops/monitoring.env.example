# 错误监控服务（GlitchTip）的参数。复制为 ops/monitoring.env 并填好；那份是本机
# 文件、已被忽略，永不入库。用法见 ops/docker-compose.monitoring.yml 的开头与
# README「错误监控」。
#
# 平台后端用的 YVRUC_SENTRY_* 不在这里，在仓库根的 .env 里。

# 监控自己那个数据库的口令。只在这两个容器之间用，随便生成一串：
#   openssl rand -hex 16
GLITCHTIP_DB_PASSWORD=

# Django 的密钥，用来签会话 Cookie。换掉它等于把所有人踢下线（也就这点影响）：
#   openssl rand -hex 32
GLITCHTIP_SECRET_KEY=

# 浏览器访问监控页面用的地址，要和实际打开的地址一字不差，否则登录表单会被
# CSRF 检查挡住。按 README 开 SSH 隧道看的话就是下面这个默认值。
GLITCHTIP_DOMAIN=http://127.0.0.1:8001

# 监控页面绑在本机的哪个端口（只绑 127.0.0.1）。8000 被平台后端的调试端口占着，
# 所以默认 8001
GLITCHTIP_HOST_PORT=8001

# 平台那套 compose 的网络名，后端就是从这个网络里把事件报进来的。
# 名字是「项目名_default」，项目名默认取仓库目录名；对不上就 `docker network ls` 查
YVRUC_PLATFORM_NETWORK=yvruc_system_default

# 事件留多少天，默认 90。平台的操作日志留 180 天，监控这边不用那么久：排查看的
# 是最近几天，而它的库里分区越多越吃锁
GLITCHTIP_RETENTION_DAYS=90

# 发件地址。没配 SMTP，所以邮件只打到容器日志里；报错提醒走平台的站内通知
GLITCHTIP_FROM_EMAIL=glitchtip@localhost
