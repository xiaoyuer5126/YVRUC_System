# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）

# —— 数据库 ——
# 数据库与后端都读这一个变量；公网部署务必改掉示例值
POSTGRES_PASSWORD=rucva_dev

# —— 演示登录 ——
# 学校统一身份认证接通前，开发小组用「学号 + 共享口令」登录。
# 留空 = 演示登录接口不存在（SSO 上线后必须留空）。
RUCVA_DEMO_PASSWORD=

# —— 宿主机端口 ——
# 只影响本机调试入口；容器之间走内部网络，不受影响。
# 端口被别的项目占用时改这里（启动报 "address already in use" 就是它）。
WEB_HOST_PORT=8080
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# —— 身份证号加密密钥 ——
# 库里的身份证号是加密存的，密钥放这里、与数据库分开保管才有意义。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 换密钥等于让已有数据读不出来，换之前要先解密导出再重新写入。
RUCVA_ID_CARD_KEY=

# —— 对外网址 ——
# 平台的正式域名（多个用逗号分隔）。二维码里写的就是它，只有列在这里的
# 域名和访问时用的域名才允许出现在码里，免得有人拿平台的接口生成指向
# 别处的二维码。留空 = 只认访问时用的那个域名。
RUCVA_PUBLIC_BASE_URL=
# 通知卡片「点击打开」的站点根，形如 https://v.ruc.edu.cn。
# 留空 = 用上面正式域名的第一个；两个都空 = 通知不带跳转链接。
RUCVA_SITE_URL=

# —— 接口文档 ——
# 设为 1 才暴露 /docs 与 /openapi.json，默认关闭
RUCVA_EXPOSE_DOCS=

# —— 学校开放平台（能力开放平台 / 统一认证）——
# 在应用中心注册应用后获得 appid 与 secret；调用任何接口都要拿它俩签名。
# 注册完还要找管理员授权接口权限，否则签名对了也调不通。
# 签名算法：sd-algorithm / sd-appid / sd-nonce / sd-timestamp 按字典序拼成
# "k=v&k=v..."，末尾接 "&key=<secret>"，取 SHA1 的十六进制大写。
RUCVA_OPENPLATFORM_APPID=
RUCVA_OPENPLATFORM_SECRET=
# 开放网关：消息中心 / 待办中心 / 日程中心的业务接口都挂在它下面
RUCVA_OPENPLATFORM_GATEWAY=https://opengw.ruc.edu.cn
# 统一身份认证：CAS 与 OAuth 两套接口都挂在它下面
RUCVA_CAS_BASE_URL=https://cas.ruc.edu.cn/cas
# OAuth 回调地址，必须与应用中心登记的**一字不差**，差一个字符换令牌时就报
# invalid_grant。指向平台的根路径：CAS 在后面追加 ?code=..&state=..，
# 前端路由守卫在根路径上接住它，转给 /sso-callback。
RUCVA_SSO_REDIRECT_URI=

# —— Cloudflare Tunnel 固定域名令牌（Zero Trust 控制台创建隧道后获取）——
CLOUDFLARE_TOKEN=

# —— 地图（管理端看签到点与范围用）——
# 地图瓦片由**本站服务器**向天地图取、再转给浏览器（/api/geo/tiles/），前端拿不到
# 任何 tk。浏览器直连时 tk 靠 Referer 域名白名单，AdGuard 隐身模式之类的插件
# 会改掉 Referer，天地图一律 403——所以由服务器转发。
#
# 天地图的**服务端** tk：瓦片转发和地名搜索都用它（主路径）。在 lbs.tianditu.gov.cn
# 另建一个应用、类型选「服务端」，并在天地图后台把**服务器的公网出口 IP** 登记进
# 白名单。它只在后端用，**不能**进前端。留空 = 地名搜索框不显示、管理端不画地图，
# 只画点和圈，定位签到功能照旧。
# 浏览器端 tk 用不上：天地图对它只认真浏览器，服务器转发带什么 Referer 都被拒。
RUCVA_TIANDITU_TK_SERVER=
# 每个 tk 每天 10000 次瓦片请求。同一张瓦片只向天地图取一次、磁盘缓存 30 天；
# 当天真正打到天地图的次数到九成记警告日志，到上限直接 503、不再请求天地图。
# 天地图给你调了额度再改这里；留空按 10000。
RUCVA_TIANDITU_DAILY_LIMIT=

# —— AI 起草（预览版）——
# 活动管理里右下角的 AI 按钮：把通知、立项书原文贴进去，起草活动基本信息或
# 场次岗位，管理者核对后才填进表单、才建。走 OpenAI 兼容的 /chat/completions，
# 默认 DeepSeek。key 留空 = 按钮不出现。贴进去的原文会发给这家服务。
RUCVA_AI_BASE_URL=https://api.deepseek.com
RUCVA_AI_MODEL=deepseek-chat
RUCVA_AI_API_KEY=
# 一次起草最多等几秒，留空按 90
RUCVA_AI_TIMEOUT=

# —— 进程与连接池 ——
# 一个 uvicorn 进程只吃一个核，加并发就得多开进程。留空按 4（8 核机器，
# 另一半留给 Postgres / Redis / nginx）。
RUCVA_WORKERS=4
# 每个进程各有一个数据库连接池，峰值连接数 = 进程数 ×(池子+溢出)。
# 上面 4 个进程时是 4×15=60，Postgres 默认上限 100——加进程顺手把这两个调小。
RUCVA_DB_POOL_SIZE=5
RUCVA_DB_MAX_OVERFLOW=10
# 每个进程最多几个请求同时去数据库排场次锁（排队期间各占一条连接），其余的
# 在进程里等、不占连接。要明显小于上面「池子+溢出」（默认 15），否则抢报时
# 连接被排队的人占光，刷页面的请求拿不到连接。留空按 5。
RUCVA_LOCK_SLOTS=5
# 每个进程的线程池上限（同步接口都在里面跑）。抢报时持号等锁的报名请求会占着
# 线程，默认 100；只多占内存，不占数据库连接。
RUCVA_THREADS=100
# 拿到名额闸门号的报名请求最多排多少秒场次锁。拿到号的人数不超过名额，给宽一点
# 不会让队伍失控；太短的话排在后面的人会被 503，名额让给了后来重试的人。留空按 30。
RUCVA_TICKET_WAIT_SECONDS=30

# —— 定时任务 ——
# 审批放着没人处理多少小时开始催审批人。只催人，绝不自动通过。留空按 24。
RUCVA_APPROVAL_REMIND_HOURS=24
# 设为 1 关掉后台定时任务（候补转正清扫、活动状态流转、签到提醒、日报、
# 自动提交时长审核……）。只给调试和测试用，生产环境必须留空。
RUCVA_DISABLE_SWEEPER=
