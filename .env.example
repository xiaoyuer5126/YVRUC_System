# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）

# —— 数据库 ——
# 数据库与后端都读这一个变量；公网部署务必改掉示例值
POSTGRES_PASSWORD=rucva_dev

# —— 演示登录 ——
# 学校统一身份认证接通前，开发小组用「学号 + 共享口令」登录。
# 留空 = 演示登录接口不存在（SSO 上线后必须留空）。
RUCVA_DEMO_PASSWORD=

# —— 宿主机端口 ——
# 只影响本机调试入口；容器之间走内部网络，不受影响。
# 端口被别的项目占用时改这里（启动报 "address already in use" 就是它）。
WEB_HOST_PORT=8080
BACKEND_HOST_PORT=8000
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# —— 接口文档 ——
# 设为 1 才暴露 /docs 与 /openapi.json，默认关闭
RUCVA_EXPOSE_DOCS=

# —— Cloudflare Tunnel 固定域名令牌（Zero Trust 控制台创建隧道后获取）——
CLOUDFLARE_TOKEN=
