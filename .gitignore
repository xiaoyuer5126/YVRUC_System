# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# ===== Node / 前端构建产物（npm install / npm run build 可再生）=====
node_modules/
web/dist/

# ===== 运行时数据（演示库 / 上传件；Docker 部署由命名卷接管）=====
data/
*.db
*.sqlite3

# ===== 环境变量与密钥（*.example 为模板，允许提交）=====
.env
.env.*
!.env.example
!.env.example.*
# 老版本内测入口 caddy 留下的 Cloudflare 令牌文件：caddy 已移除，机器上还留着这份时也不能入库
caddy.env
# 错误监控服务的库口令与密钥：同理，模板是 ops/monitoring.env.example
ops/monitoring.env
!ops/monitoring.env.example

# ===== 证书与私钥（学校发的 *.ruc.edu.cn 证书放这里；与 .env 同级机密）=====
.certs/
certs/
*.pem
*.key

# ===== 日志 / 临时文件 =====
*.log
*.tmp
tmp/

# ===== IDE / 操作系统 =====
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# ===== 备份（docker compose 的 backup 服务写到这里，见 README）=====
backups/
